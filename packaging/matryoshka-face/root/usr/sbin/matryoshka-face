#!/bin/sh
C=/usr/lib/security/howdy/config.ini
AUTH=/usr/sbin/matryoshka-auth
[ "$(id -u)" = 0 ] || exec pkexec "$0" "$@"
cams() {
  for d in /dev/video*; do
    [ -c "$d" ] || continue
    f=$(v4l2-ctl -d "$d" --list-formats 2>/dev/null) || continue
    echo "$f" | grep -q "\[[0-9]*\]" || continue
    n=$(v4l2-ctl -d "$d" --info 2>/dev/null | sed -n 's/.*Card type *: //p')
    if echo "$f" | grep -q -E "'GREY'|'Y8 '|'Y800'" || echo "$n" | grep -qi "ir"; then echo "ir $d $n"; else echo "rgb $d $n"; fi
  done
}
pick() { cams | sort | head -1; }
stable() {
  for l in /dev/v4l/by-path/* /dev/v4l/by-id/*; do
    [ -L "$l" ] && [ "$(readlink -f "$l")" = "$1" ] && { echo "$l"; return; }
  done
  echo "$1"
}
setdev() {
  s=$(stable "$1")
  sed -i "s#^device_path = .*#device_path = $s#" "$C"
  mkdir -p /etc/matryoshka; echo "$s" > /etc/matryoshka/face-device
}
case "$1" in
  cameras) cams;;
  fixpath)
    cur=$(sed -n 's/^device_path = //p' "$C")
    case "$cur" in /dev/v4l/*) [ -e "$cur" ] && exit 0;; esac
    saved=$(cat /etc/matryoshka/face-device 2>/dev/null)
    if [ -n "$saved" ] && [ -e "$saved" ]; then setdev "$(readlink -f "$saved")"; exit 0; fi
    if [ -n "$cur" ] && [ "$cur" != none ] && [ -e "$cur" ]; then setdev "$(readlink -f "$cur")"; exit 0; fi
    grep -qs howdy /etc/pam.d/sddm /etc/pam.d/matryoshka-login /etc/pam.d/kde-smartcard || exit 0
    c=$(pick); [ -n "$c" ] || exit 0
    set -- $c; setdev "$2"
    [ "$1" = rgb ] && sed -i 's/^dark_threshold = .*/dark_threshold = 80/' "$C"
    exit 0;;
  on)
    c=$(pick); [ -n "$c" ] || { echo "Камера не найдена"; exit 1; }
    set -- $c; dev=$2
    setdev "$dev"
    if [ "$1" = rgb ]; then sed -i 's/^dark_threshold = .*/dark_threshold = 80/' "$C"; echo "ВНИМАНИЕ: инфракрасной камеры нет, используется обычная ($dev). Такую защиту можно обмануть фотографией. Пароль работает всегда."; else echo "Инфракрасная камера: $dev"; fi
    [ -x "$AUTH" ] || { echo "Нет $AUTH (нужна Матрёшка 18.6)"; exit 1; }
    "$AUTH" face on >/dev/null || exit 1
    echo "Вход по лицу включён для экрана входа. Введённый пароль проверяется сразу, без ожидания камеры. Для входа по лицу оставьте поле пароля пустым и нажмите Enter. Добавьте лицо: matryoshka-face add";;
  off) if [ -x "$AUTH" ]; then "$AUTH" face off >/dev/null; else for p in sddm kde; do [ -f /etc/pam.d/$p ] && sed -i '/howdy/d' /etc/pam.d/$p; done; fi; echo "Вход по лицу выключен";;
  add) u=${2:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}; [ -n "$u" ] || { echo "matryoshka-face add ПОЛЬЗОВАТЕЛЬ"; exit 1; }; grep -q "^device_path = /dev" "$C" || "$0" on >/dev/null; SUDO_USER="$u" howdy -U "$u" add -y;;
  import) u=${2:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}; [ -n "$u" ] && [ -f "$3" ] || exit 1; python3 /usr/lib/matryoshka-face/import.py "$u" "$3";;
  clear) u=${2:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}; SUDO_USER="$u" howdy -U "$u" clear -y;;
  test) howdy test;;
  check) u=${2:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}; [ -n "$u" ] || exit 1; SUDO_USER="$u" howdy -U "$u" list >/dev/null 2>&1 || { echo "Лицо ещё не записано"; exit 2; }; echo "Смотрите в камеру..."; if PYTHONWARNINGS=ignore timeout 30 python3 /lib/security/howdy/compare.py "$u" >/dev/null 2>&1; then echo "Лицо узнано"; else echo "Лицо не узнано, попробуйте записать ещё снимок"; exit 3; fi;;
  list) u=${2:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}; SUDO_USER="$u" howdy -U "$u" list 2>&1 | grep -v WARN;;
  status) grep "^device_path" "$C"; grep -l howdy /etc/pam.d/* 2>/dev/null;;
  *) echo "matryoshka-face on|off|fixpath|add [пользователь]|import пользователь файл|clear|check|list|cameras|test|status"; exit 1;;
esac
