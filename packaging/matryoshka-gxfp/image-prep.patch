 static void
+blur_rows_cols (const gfloat *src, gfloat *dst, gint w, gint h, gdouble sigma)
+{
+  gint rad = (gint) (sigma * 3.0 + 0.5);
+  g_autofree gfloat *k = g_new0 (gfloat, 2 * rad + 1);
+  g_autofree gfloat *tmp = g_new0 (gfloat, (gsize) w * h);
+  gfloat sum = 0;
+
+  for (gint i = -rad; i <= rad; i++)
+    sum += k[i + rad] = (gfloat) exp (-(gdouble) (i * i) / (2.0 * sigma * sigma));
+  for (gint i = 0; i <= 2 * rad; i++)
+    k[i] /= sum;
+  for (gint y = 0; y < h; y++)
+    for (gint x = 0; x < w; x++)
+      {
+        gfloat a = 0;
+        for (gint i = -rad; i <= rad; i++)
+          a += k[i + rad] * src[(gsize) y * w + CLAMP (x + i, 0, w - 1)];
+        tmp[(gsize) y * w + x] = a;
+      }
+  for (gint y = 0; y < h; y++)
+    for (gint x = 0; x < w; x++)
+      {
+        gfloat a = 0;
+        for (gint i = -rad; i <= rad; i++)
+          a += k[i + rad] * tmp[(gsize) CLAMP (y + i, 0, h - 1) * w + x];
+        dst[(gsize) y * w + x] = a;
+      }
+}
+
+static gint
+cmp_float (gconstpointer a, gconstpointer b)
+{
+  gfloat x = *(const gfloat *) a, y = *(const gfloat *) b;
+
+  return (x > y) - (x < y);
+}
+
+static void
+frame_stats (const gfloat *v, gsize n, gdouble *mn, gdouble *mx, gdouble *mean, gdouble *sd)
+{
+  gdouble s = 0, s2 = 0;
+
+  *mn = G_MAXDOUBLE;
+  *mx = -G_MAXDOUBLE;
+  for (gsize i = 0; i < n; i++)
+    {
+      s += v[i];
+      s2 += (gdouble) v[i] * v[i];
+      *mn = MIN (*mn, v[i]);
+      *mx = MAX (*mx, v[i]);
+    }
+  *mean = s / n;
+  *sd = sqrt (MAX (0.0, s2 / n - *mean * *mean));
+}
+
+static gboolean
+prepare_image (FpiDeviceGxfp *self, const struct gxfp_decoded_image *img, guint8 *out)
+{
+  gint w = img->cols, h = img->rows;
+  gsize n = (gsize) w * h;
+  const gchar *mode = g_getenv ("FP_GXFP_PREP");
+  gboolean hp = !(mode && g_strcmp0 (mode, "raw") == 0);
+  g_autofree gfloat *f = g_new (gfloat, n);
+  g_autofree gfloat *bl = g_new (gfloat, n);
+  g_autofree gfloat *srt = NULL;
+  gdouble mn, mx, mean, sd, hsd = 0, nsd = 0, lo, hi;
+
+  for (gsize i = 0; i < n; i++)
+    f[i] = img->pixels[i];
+  frame_stats (f, n, &mn, &mx, &mean, &sd);
+  blur_rows_cols (f, bl, w, h, 1.0);
+  {
+    g_autofree gfloat *d = g_new (gfloat, n);
+    g_autofree gfloat *b4 = g_new (gfloat, n);
+    gdouble a, b, c;
+
+    for (gsize i = 0; i < n; i++)
+      d[i] = f[i] - bl[i];
+    frame_stats (d, n, &a, &b, &c, &nsd);
+    blur_rows_cols (f, b4, w, h, 4.0);
+    for (gsize i = 0; i < n; i++)
+      d[i] = bl[i] - b4[i];
+    frame_stats (d, n, &a, &b, &c, &hsd);
+    if (hp)
+      for (gsize i = 0; i < n; i++)
+        f[i] = f[i] - b4[i];
+  }
+  srt = g_memdup2 (f, n * sizeof (gfloat));
+  qsort (srt, n, sizeof (gfloat), cmp_float);
+  lo = hp ? srt[n / 100] : 0;
+  hi = hp ? srt[n - 1 - n / 100] : 4095;
+  if (hi <= lo)
+    hi = lo + 1;
+  for (gsize i = 0; i < n; i++)
+    {
+      gdouble v = (f[i] - lo) * 255.0 / (hi - lo);
+      out[i] = (guint8) CLAMP (v + 0.5, 0, 255);
+    }
+  g_message ("gxfp frame %dx%d raw min %.0f max %.0f mean %.1f sd %.1f ridge %.1f noise %.1f q %.2f dark %s prep %s",
+             w, h, mn, mx, mean, sd, hsd, nsd, nsd > 0 ? hsd / nsd : 0,
+             gxfp_session_dark_loaded (&self->sess) ? "yes" : "no", hp ? "hp" : "raw");
+  if (g_getenv ("FP_GXFP_MIN_Q") && nsd > 0 && hsd / nsd < g_ascii_strtod (g_getenv ("FP_GXFP_MIN_Q"), NULL))
+    {
+      g_message ("gxfp frame rejected: quality %.2f below %s", hsd / nsd, g_getenv ("FP_GXFP_MIN_Q"));
+      return FALSE;
+    }
+  return TRUE;
+}
+
+static void
+dump_raw (FpiDeviceGxfp *self, const struct gxfp_decoded_image *img)
+{
+  const gchar *dir = g_getenv ("FP_GXFP_DUMP");
+  g_autofree gchar *path = NULL;
+  g_autoptr(GString) pgm = NULL;
+  static guint seq = 0;
+
+  if (!dir || dir[0] == '\0')
+    return;
+  g_mkdir_with_parents (dir, 0700);
+  path = g_strdup_printf ("%s/%" G_GINT64_FORMAT "-%04u-raw16.pgm", dir, g_get_real_time () / 1000, seq++);
+  pgm = g_string_new (NULL);
+  g_string_append_printf (pgm, "P5\n%d %d\n4095\n", img->cols, img->rows);
+  for (gsize i = 0; i < (gsize) img->cols * img->rows; i++)
+    {
+      g_string_append_c (pgm, (gchar) (img->pixels[i] >> 8));
+      g_string_append_c (pgm, (gchar) (img->pixels[i] & 0xff));
+    }
+  g_file_set_contents (path, pgm->str, pgm->len, NULL);
+}
