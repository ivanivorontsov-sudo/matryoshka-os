#!/bin/bash
export WINEPREFIX=${WINEPREFIX:-$HOME/.wine}
export WINEARCH=${WINEARCH:-win64}
export WINEDEBUG=${WINEDEBUG:-err+all}
export ELECTRON_DISABLE_SANDBOX=1 ELECTRON_NO_ATTACH_CONSOLE=1
export MOZ_DISABLE_WIN32K_LOCKDOWN=1 MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GPU_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1 MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_DISABLE_UTILITY_SANDBOX=1 MOZ_DISABLE_VR_SANDBOX=1
LOG=$HOME/.cache/matryoshka-wine.log
mkdir -p "$(dirname "$LOG")"
W=wine; command -v wine >/dev/null || W=/usr/lib/wine/wine64
command -v "$W" >/dev/null || { echo "wine не установлен: sudo apt install wine wine64 wine32:i386"; exit 1; }
dflt="mshtml=;winemenubuilder.exe=d"; [ -e "$WINEPREFIX/.matryoshka-mono" ] || dflt="mscoree=;$dflt"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}$dflt"
if [ ! -f "$WINEPREFIX/system.reg" ]; then
  WINEDLLOVERRIDES="mscoree=;mshtml=;winemenubuilder.exe=d" DISPLAY= "$W" wineboot -i >>"$LOG" 2>&1
  wineserver -w
  "$W" reg add 'HKCU\Software\Wine\X11 Driver' /v UseXRandR /d N /f >/dev/null 2>&1
  "$W" reg add 'HKCU\Software\Wine\X11 Driver' /v UseXVidMode /d N /f >/dev/null 2>&1
  "$W" winecfg -v win10 >/dev/null 2>&1
  for s in wineusb winebth; do "$W" reg add "HKLM\\System\\CurrentControlSet\\Services\\$s" /v Start /t REG_DWORD /d 4 /f >/dev/null 2>&1; done
fi
[ "$1" = --fix-fonts ] && exec /usr/lib/matryoshka-fixes/wine-fonts --force
/usr/lib/matryoshka-fixes/wine-fonts
ffprefs() {
  for d in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/Mozilla/Firefox/Profiles/*/; do
    [ -d "$d" ] || continue
    cp /usr/share/matryoshka-fixes/firefox-prefs.js "$d/user.js"
  done
}
[ -z "$1" ] && { echo "matryoshka-wine файл.exe|файл.msi [аргументы] | --fix-fonts"; exit 1; }
case "${1,,}" in
  *.msi) f=$(readlink -f "$1"); shift; set -- msiexec /i "$f" "$@";;
  *.exe|*.bat|*.com) f=$(readlink -f "$1"); shift; cd "$(dirname "$f")"
    b=$(basename "${f,,}")
    if [ "$b" = firefox.exe ]; then ffprefs; mkdir -p defaults/pref 2>/dev/null && sed -n 's/^user_pref(/pref(/p' /usr/share/matryoshka-fixes/firefox-prefs.js > defaults/pref/matryoshka.js 2>/dev/null; [ -e "$WINEPREFIX/.matryoshka-win10" ] || { "$W" winecfg -v win10 >/dev/null 2>&1; touch "$WINEPREFIX/.matryoshka-win10"; }; set -- "$f" -no-remote "$@"
    elif [ -e resources/app.asar ] || [ -d resources/app ] || { [ -e libEGL.dll ] && ls *.pak >/dev/null 2>&1; }; then
      set -- "$f" --no-sandbox --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-hang-monitor --disable-features=CalculateNativeWinOcclusion,RendererCodeIntegrity --disable-renderer-backgrounding "$@"
    else set -- "$f" "$@"; fi;;
esac
"$W" "$@" > >(tee "$LOG") 2>&1; rc=$?
[ "$1" = msiexec ] && { wineserver -w; ffprefs; }
[ $rc != 0 ] && { echo "Ошибка $rc, лог: $LOG"; command -v kdialog >/dev/null && [ -n "$DISPLAY$WAYLAND_DISPLAY" ] && kdialog --error "Программа Windows завершилась с ошибкой $rc.\nЛог: $LOG"; }
exit $rc
