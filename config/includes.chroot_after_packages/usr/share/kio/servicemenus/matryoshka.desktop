[Desktop Entry]
Name=Матрёшка
Type=Service
MimeType=all/allfiles;inode/directory;
Actions=link;encLink;toShared;openWin;installAndroid;scan
X-KDE-Submenu=Поделиться

[Desktop Action toShared]
Name=Положить в «Общее» (видно Windows- и Android-программам)
Icon=folder-publicshare
Exec=cp -r %F "$HOME/Общее/"

[Desktop Action openWin]
Name=Открыть Windows-программой (Wine)
Icon=wine
Exec=wine start /unix %f

[Desktop Action installAndroid]
Name=Открыть или установить в Android
Icon=android
Exec=matryoshka-run %f

[Desktop Action scan]
Name=Проверить антивирусом
Icon=security-high
Exec=konsole --hold -e matryoshka-av scan %F

[Desktop Action link]
Name=Получить ссылку (открывается в любом браузере)
Icon=emblem-shared-symbolic
Exec=matryoshka-share %F

[Desktop Action encLink]
Name=Получить зашифрованную ссылку (с паролем)
Icon=document-encrypt
Exec=matryoshka-share --enc %F
