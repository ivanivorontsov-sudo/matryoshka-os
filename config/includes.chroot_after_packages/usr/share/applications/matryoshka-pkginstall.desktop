[Desktop Entry]
Type=Application
Name=Установка программ
Exec=matryoshka-pkginstall %f
Icon=system-software-install
MimeType=application/vnd.debian.binary-package;application/x-deb;application/vnd.appimage;application/x-iso9660-appimage;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-zstd-compressed-tar;application/x-tar;
NoDisplay=true
