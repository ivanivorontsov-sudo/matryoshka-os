#!/bin/bash
set -u
CONF=/etc/matryoshka/auth.conf
STATE=/var/lib/matryoshka/auth
GREETER_CONF=/etc/sddm.conf.d/10-matryoshka-greeter.conf
HOWDY=/lib/security/howdy/pam.py
FP_LOCK_ARGS="max-tries=5 timeout=-1"
FP_LOGIN_ARGS="max-tries=3 timeout=15"
FP_ADMIN_ARGS="max-tries=2 timeout=10"
CONFIRM=/usr/lib/matryoshka/pam_confirm.py
EMPTY=/usr/lib/matryoshka/pam-empty-authtok
THEME_CONF=/etc/sddm.conf.d/zz-matryoshka-finger.conf
THEME_PY=/usr/lib/matryoshka/sddm_theme.py
FP_ONCE=/var/lib/matryoshka/auth/finger-login-18.6.5
NOASK_RULE=/etc/polkit-1/rules.d/47-matryoshka-noask.rules
[ "$(id -u)" = 0 ] || exec pkexec "$0" "$@"

mod() {
  local d
  for d in /usr/lib/x86_64-linux-gnu/security /lib/x86_64-linux-gnu/security /usr/lib/security /lib/security; do
    [ -e "$d/$1" ] && return 0
  done
  return 1
}

vendor() {
  if [ -f "/usr/lib/pam.d/$1" ]; then echo "/usr/lib/pam.d/$1"; elif [ -f "/etc/pam.d/$1" ] && ! owned "$1"; then echo "/etc/pam.d/$1"; fi
}

owned() { [ -f "$STATE/owned" ] && grep -qx "$1" "$STATE/owned"; }

own() { mkdir -p "$STATE"; owned "$1" || echo "$1" >> "$STATE/owned"; }

disown_file() {
  [ -f "$STATE/owned" ] || return 0
  grep -vx "$1" "$STATE/owned" > "$STATE/owned.new"; mv "$STATE/owned.new" "$STATE/owned"
}

put() {
  local f=$1 t
  t=$(mktemp "/etc/pam.d/.$f.XXXXXX") || return 1
  cat > "$t"; chmod 644 "$t"
  if [ -f "/etc/pam.d/$f" ] && cmp -s "$t" "/etc/pam.d/$f"; then rm -f "$t"; else mv -f "$t" "/etc/pam.d/$f"; fi
}

get() {
  local k=$1 d=$2 v
  v=$(sed -n "s/^$k=\([01]\)$/\1/p" "$CONF" 2>/dev/null | tail -n 1)
  echo "${v:-$d}"
}

mode() {
  local v
  v=$(sed -n 's/^ADMIN_MODE=\(password\|confirm\|none\)$/\1/p' "$CONF" 2>/dev/null | tail -n 1)
  echo "${v:-confirm}"
}

enrolled() { find /var/lib/fprint -mindepth 2 -type f 2>/dev/null | grep -q .; }

migrate() {
  [ -f "$CONF" ] && return 0
  local fl=0 fs=0 fa=0 fc=0 lock=1
  grep -qs pam_fprintd /etc/pam.d/sddm && fl=1
  grep -qs pam_fprintd /etc/pam.d/sudo && fs=1
  grep -qs howdy /etc/pam.d/sddm && fc=1
  mkdir -p "$(dirname "$CONF")"
  printf 'FINGER_LOCK=%s\nFINGER_LOGIN=%s\nFINGER_SUDO=%s\nFINGER_POLKIT=%s\nFACE_LOGIN=%s\nFACE_LOCK=%s\nGREETER_RU=1\nADMIN_MODE=confirm\n' "$lock" "$fl" "$fs" "$fa" "$fc" "$fc" > "$CONF"
}

setkey() {
  migrate
  if grep -q "^$1=" "$CONF"; then sed -i "s/^$1=.*/$1=$2/" "$CONF"; else echo "$1=$2" >> "$CONF"; fi
}

strip_bio() { [ -f "$1" ] && sed -i '/howdy/d; /pam_fprintd/d' "$1"; return 0; }

login_stack() {
  local face=$1 finger=$2 bio=() n i fp=0 gate=0
  [ "$face" = 1 ] && [ -f "$HOWDY" ] && mod pam_python.so && bio+=("pam_python.so $HOWDY")
  [ "$finger" = 1 ] && mod pam_fprintd.so && fp=1
  [ "$fp" = 1 ] && [ -x "$EMPTY" ] && mod pam_exec.so && gate=1
  n=${#bio[@]}
  printf 'auth\t[success=%d default=ignore]\tpam_unix.so nullok\n' $((n + fp + gate + 1))
  [ "$gate" = 1 ] && printf 'auth\t[success=ignore default=%d]\tpam_exec.so quiet expose_authtok %s\n' $((fp + n)) "$EMPTY"
  [ "$fp" = 1 ] && printf 'auth\t[success=%d default=ignore]\tpam_fprintd.so %s\n' $((n + 1)) "$FP_LOGIN_ARGS"
  for ((i = 0; i < n; i++)); do printf 'auth\t[success=%d default=ignore]\t%s\n' $((n - i)) "${bio[$i]}"; done
  printf 'auth\trequisite\tpam_deny.so\n'
  printf 'auth\trequired\tpam_permit.so\n'
}

apply_sddm() {
  local face finger f=/etc/pam.d/sddm
  [ -f "$f" ] || return 0
  face=$(get FACE_LOGIN 0); finger=$(get FINGER_LOGIN 0)
  strip_bio "$f"
  if [ "$face" = 1 ] || [ "$finger" = 1 ]; then
    login_stack "$face" "$finger" | put matryoshka-login; own matryoshka-login
    sed -i 's/^@include[[:space:]]\+common-auth[[:space:]]*$/@include matryoshka-login/' "$f"
  else
    sed -i 's/^@include[[:space:]]\+matryoshka-login[[:space:]]*$/@include common-auth/' "$f"
    owned matryoshka-login && { rm -f /etc/pam.d/matryoshka-login; disown_file matryoshka-login; }
  fi
  grep -q '^@include[[:space:]]\+\(common-auth\|matryoshka-login\)' "$f" || echo "ВНИМАНИЕ: в /etc/pam.d/sddm нет строки common-auth, вход проверьте вручную"
  apply_theme "$finger"
}

apply_theme() {
  if [ "$1" = 1 ] && grep -qs pam_fprintd /etc/pam.d/matryoshka-login && [ -f "$THEME_PY" ] && python3 "$THEME_PY" build >/dev/null 2>&1; then
    mkdir -p "$(dirname "$THEME_CONF")"
    printf '[Theme]\nCurrent=matryoshka\n' > "$THEME_CONF.new"
    if cmp -s "$THEME_CONF.new" "$THEME_CONF"; then rm -f "$THEME_CONF.new"; else chmod 644 "$THEME_CONF.new"; mv -f "$THEME_CONF.new" "$THEME_CONF"; fi
  else
    rm -f "$THEME_CONF"
  fi
}

fp_decided() { mkdir -p "$STATE"; date -Is > "$FP_ONCE"; }

finger_once() {
  [ -e "$FP_ONCE" ] && return 0
  enrolled || return 0
  mod pam_fprintd.so || return 0
  fp_decided
  [ "$(get FINGER_LOGIN 0)" = 1 ] && return 0
  setkey FINGER_LOGIN 1
  logger -t matryoshka-auth "вход по отпечатку на экране входа включён (пароль остаётся)"
}

apply_lock() {
  local v lock
  [ -f /etc/pam.d/kde ] && ! owned kde && strip_bio /etc/pam.d/kde
  v=$(vendor kde-fingerprint)
  [ -n "$v" ] || return 0
  lock=$(get FINGER_LOCK 1)
  if [ "$lock" = 1 ]; then
    sed "s#^\(auth[[:space:]]\+required[[:space:]]\+pam_fprintd\.so\).*#\1 $FP_LOCK_ARGS#" "$v" | put kde-fingerprint
  else
    sed "s#^auth[[:space:]]\+required[[:space:]]\+pam_fprintd\.so.*#auth\trequired\tpam_deny.so#" "$v" | put kde-fingerprint
  fi
  own kde-fingerprint
  v=$(vendor kde-smartcard)
  if [ "$(get FACE_LOCK "$(get FACE_LOGIN 0)")" = 1 ] && [ -f "$HOWDY" ] && mod pam_python.so && [ -n "$v" ]; then
    sed -e '/^#\?auth[[:space:]].*pam_sss\.so/d' -e '/^#auth[[:space:]]/d' -e "s#^\(auth[[:space:]]\+requisite[[:space:]]\+pam_nologin\.so.*\)#\1\nauth\trequisite\tpam_exec.so quiet /usr/lib/matryoshka/face-lock-ok\nauth\trequired\tpam_python.so $HOWDY#" "$v" | put kde-smartcard
    own kde-smartcard
  elif owned kde-smartcard; then
    rm -f /etc/pam.d/kde-smartcard; disown_file kde-smartcard
  fi
}

admin_file() {
  local name=$1 f=/etc/pam.d/$1 v
  if [ ! -f "$f" ]; then v=$(vendor "$name"); [ -n "$v" ] || return 1; cp "$v" "$f"; own "$name"; fi
  sed -i '/pam_fprintd/d; /pam_confirm\.py/d' "$f"
}

drop_admin_file() {
  if owned "$1"; then rm -f "/etc/pam.d/$1"; disown_file "$1"; else [ -f "/etc/pam.d/$1" ] && sed -i '/pam_fprintd/d; /pam_confirm\.py/d' "/etc/pam.d/$1"; fi
  return 0
}

apply_admin() {
  local name f m fin conf lines
  m=$(mode)
  for name in sudo polkit-1; do
    f=/etc/pam.d/$name; fin=0; conf=0
    if [ "$name" = sudo ]; then [ "$(get FINGER_SUDO 0)" = 1 ] && fin=1
    else
      [ "$(get FINGER_POLKIT 0)" = 1 ] && fin=1
      [ "$m" = confirm ] && [ -f "$CONFIRM" ] && mod pam_python.so && conf=1
    fi
    mod pam_fprintd.so || fin=0
    if [ "$fin" = 1 ] || [ "$conf" = 1 ]; then
      admin_file "$name" || continue
      lines=""
      [ "$conf" = 1 ] && lines=$(printf 'auth\t[success=done default=ignore]\tpam_python.so %s' "$CONFIRM")
      [ "$fin" = 1 ] && lines="${lines:+$lines
}$(printf 'auth\tsufficient\tpam_fprintd.so %s' "$FP_ADMIN_ARGS")"
      awk -v ins="$lines" '!d && /^@include[ \t]+common-auth/ {print ins; d=1} {print}' "$f" > "$f.new" && cat "$f.new" > "$f"; rm -f "$f.new"
    else
      drop_admin_file "$name"
    fi
  done
  if [ "$m" = none ]; then
    mkdir -p "$(dirname "$NOASK_RULE")"
    cat > "$NOASK_RULE.new" <<'R'
polkit.addRule(function(action, subject) {
    if (!subject.local || !subject.active) return;
    if (!subject.isInGroup("sudo") && !subject.isInGroup("wheel")) return;
    return polkit.Result.YES;
});
R
    chmod 644 "$NOASK_RULE.new"; mv -f "$NOASK_RULE.new" "$NOASK_RULE"
  else
    rm -f "$NOASK_RULE"
  fi
  for name in common-auth su login sudo-i; do [ -f "/etc/pam.d/$name" ] && sed -i "/howdy/d" "/etc/pam.d/$name"; done
}

apply_greeter() {
  local l=ru_RU.UTF-8
  if [ "$(get GREETER_RU 1)" != 1 ]; then rm -f "$GREETER_CONF"; return 0; fi
  if ! locale -a 2>/dev/null | grep -qix 'ru_RU.utf8'; then
    if [ -f /etc/locale.gen ]; then
      grep -q '^ru_RU.UTF-8 UTF-8' /etc/locale.gen || { sed -i 's/^#[[:space:]]*\(ru_RU.UTF-8 UTF-8\)/\1/' /etc/locale.gen; grep -q '^ru_RU.UTF-8 UTF-8' /etc/locale.gen || echo 'ru_RU.UTF-8 UTF-8' >> /etc/locale.gen; }
      command -v locale-gen >/dev/null && locale-gen >/dev/null 2>&1
    fi
  fi
  mkdir -p "$(dirname "$GREETER_CONF")"
  printf '[General]\nGreeterEnvironment=LANG=%s,LANGUAGE=ru_RU:ru,LC_MESSAGES=%s\n' "$l" "$l" > "$GREETER_CONF.new"
  if cmp -s "$GREETER_CONF.new" "$GREETER_CONF"; then rm -f "$GREETER_CONF.new"; else mv -f "$GREETER_CONF.new" "$GREETER_CONF"; chmod 644 "$GREETER_CONF"; fi
}

apply() {
  migrate
  finger_once
  apply_sddm
  apply_lock
  apply_admin
  apply_greeter
  return 0
}

pamfile() {
  if [ -f "/etc/pam.d/$1" ]; then echo "/etc/pam.d/$1"; elif [ -f "/usr/lib/pam.d/$1" ]; then echo "/usr/lib/pam.d/$1"; fi
}

check_file() {
  local f bad=0 kind a b
  f=/etc/pam.d/$1; [ -f "$f" ] || return 0
  while read -r kind a b; do
    case "$kind" in
      inc) [ -n "$(pamfile "$a")" ] || { echo "PAM $1: нет файла $a"; bad=1; } ;;
      mod)
        case "$a" in /*) [ -e "$a" ] ;; *) mod "$a" ;; esac || { echo "PAM $1: нет модуля $a"; bad=1; continue; }
        if [ "$a" = pam_python.so ]; then
          [ -f "$b" ] || { echo "PAM $1: нет файла $b"; bad=1; continue; }
          [ "$b" = "$CONFIRM" ] && ! python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$b" 2>/dev/null && { echo "PAM $1: ошибка в $b"; bad=1; }
        fi ;;
    esac
  done < <(awk '/^[ \t]*(#|$)/ {next} $1=="@include" {print "inc", $2; next} $1 ~ /^-/ || $2 == "optional" {next} {s=$0; sub(/^[ \t]*[a-z]+[ \t]+/, "", s); if (s ~ /^\[/) sub(/^\[[^]]*\][ \t]*/, "", s); else sub(/^[^ \t]+[ \t]*/, "", s); n=split(s, x, /[ \t]+/); print "mod", x[1], (n > 1 ? x[2] : "")}' "$f")
  return $bad
}

check() {
  local n bad=0
  for n in sddm matryoshka-login kde kde-fingerprint kde-smartcard sudo polkit-1 common-auth login; do check_file "$n" || bad=1; done
  if [ -f /etc/pam.d/sddm ] && ! grep -q '^@include[[:space:]]\+\(common-auth\|matryoshka-login\)' /etc/pam.d/sddm && ! grep -q '^auth' /etc/pam.d/sddm; then echo "PAM sddm: нет проверки пароля"; bad=1; fi
  [ -f /etc/pam.d/matryoshka-login ] && ! grep -q 'pam_unix\.so' /etc/pam.d/matryoshka-login && { echo "PAM matryoshka-login: нет входа по паролю"; bad=1; }
  [ $bad = 0 ] && echo "PAM: проверка пройдена"
  return $bad
}

SNAP_FILES="etc/pam.d etc/matryoshka/auth.conf var/lib/matryoshka/auth/owned etc/polkit-1/rules.d/47-matryoshka-noask.rules etc/sddm.conf.d/10-matryoshka-greeter.conf etc/sddm.conf.d/zz-matryoshka-finger.conf"

snapshot() {
  local out=${1:-$STATE/good.tar} l=() x
  mkdir -p "$STATE"
  for x in $SNAP_FILES; do [ -e "/$x" ] && l+=("$x"); done
  tar -C / -cpf "$out.new" "${l[@]}" && mv -f "$out.new" "$out"
}

restore_snap() {
  local t=${1:-$STATE/good.tar} n
  [ -f "$t" ] || return 1
  if [ -f "$STATE/owned" ]; then while read -r n; do [ -n "$n" ] && rm -f "/etc/pam.d/$n"; done < "$STATE/owned"; rm -f "$STATE/owned"; fi
  rm -f "$NOASK_RULE" "$THEME_CONF"
  tar -C / -xpf "$t"
}

reset_safe() {
  local n
  if [ -f "$STATE/owned" ]; then while read -r n; do [ -n "$n" ] && rm -f "/etc/pam.d/$n"; done < "$STATE/owned"; rm -f "$STATE/owned"; fi
  [ -f /etc/pam.d/sddm ] && sed -i 's/^@include[[:space:]]\+matryoshka-login[[:space:]]*$/@include common-auth/' /etc/pam.d/sddm
  rm -f "$THEME_CONF"
  for n in sddm kde sudo polkit-1 common-auth login su sudo-i; do [ -f "/etc/pam.d/$n" ] && sed -i '/howdy/d; /pam_fprintd/d; /pam_confirm\.py/d' "/etc/pam.d/$n"; done
  rm -f "$NOASK_RULE"
}

boot() {
  if grep -qw matryoshka.safeauth /proc/cmdline; then reset_safe; echo "matryoshka.safeauth: вход только по паролю"; return 0; fi
  apply
  if check; then snapshot; return 0; fi
  echo "PAM после применения настроек неисправен, возвращаю последнее рабочее состояние"
  if restore_snap && check; then echo "возвращено рабочее состояние $STATE/good.tar"; return 0; fi
  reset_safe; check || true
  echo "включён вход только по паролю"
}

status() {
  migrate
  local k
  for k in FINGER_LOCK FINGER_LOGIN FINGER_SUDO FINGER_POLKIT FACE_LOGIN FACE_LOCK GREETER_RU; do echo "$k=$(get $k 0)"; done
  echo "ADMIN_MODE=$(mode)"
  enrolled && echo "отпечатки записаны: да" || echo "отпечатки записаны: нет"
  grep -l -E 'pam_fprintd|howdy|matryoshka-login|pam_confirm' /etc/pam.d/* 2>/dev/null | sed 's/^/PAM: /'
}

onoff() { case "$1" in on) echo 1;; off) echo 0;; *) echo "нужно on или off" >&2; exit 2;; esac; }

case "${1:-}" in
  apply) apply;;
  boot) boot;;
  check) check;;
  snapshot) snapshot "${2:-$STATE/good.tar}";;
  restore) restore_snap "${2:-$STATE/good.tar}" && check;;
  reset) reset_safe; check;;
  status) status;;
  finger)
    v=$(onoff "${2:-}"); fp_decided; setkey FINGER_LOGIN "$v"; setkey FINGER_LOCK "$v"; apply
    [ "$v" = 1 ] && echo "Отпечаток включён для экрана входа и блокировки. На экране входа оставьте поле пароля пустым, нажмите Enter и приложите палец." || echo "Отпечаток выключен для экрана входа и блокировки";;
  finger-lock) v=$(onoff "${2:-}"); setkey FINGER_LOCK "$v"; apply; echo готово;;
  finger-login) v=$(onoff "${2:-}"); fp_decided; setkey FINGER_LOGIN "$v"; apply; echo готово;;
  finger-sudo) v=$(onoff "${2:-}"); setkey FINGER_SUDO "$v"; apply; echo готово;;
  finger-polkit)
    v=$(onoff "${2:-}"); setkey FINGER_POLKIT "$v"; apply
    [ "$v" = 1 ] && echo "Окна запроса прав администратора принимают отпечаток. Если палец не приложить, через 10 секунд можно ввести пароль." || echo "Окна запроса прав снова спрашивают только пароль";;
  face) v=$(onoff "${2:-}"); setkey FACE_LOGIN "$v"; setkey FACE_LOCK "$v"; apply; echo готово;;
  face-lock) v=$(onoff "${2:-}"); setkey FACE_LOCK "$v"; apply; echo готово;;
  admin-mode)
    case "${2:-}" in password|confirm|none) ;; *) echo "нужно password, confirm или none" >&2; exit 2;; esac
    setkey ADMIN_MODE "$2"; apply
    case "$2" in
      password) echo "Окна прав администратора спрашивают пароль (один раз за сеанс)";;
      confirm) echo "Окна прав администратора просят только подтверждение кнопкой OK";;
      none) echo "Действия администратора выполняются без вопросов. Это небезопасно: любая программа в вашем сеансе получит права root";;
    esac;;
  greeter-ru) v=$(onoff "${2:-}"); setkey GREETER_RU "$v"; apply; echo готово;;
  *) echo "matryoshka-auth apply|boot|check|snapshot [ФАЙЛ]|restore [ФАЙЛ]|reset|status|finger on|off|finger-lock on|off|finger-login on|off|finger-sudo on|off|finger-polkit on|off|face on|off|face-lock on|off|admin-mode password|confirm|none|greeter-ru on|off"; exit 1;;
esac
