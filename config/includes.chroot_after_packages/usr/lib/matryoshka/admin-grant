#!/bin/sh
uid=${PKEXEC_UID:-}
[ -n "$uid" ] || exit 1
user=$(id -nu "$uid") || exit 1
id -nG "$user" | tr ' ' '\n' | grep -qx sudo || { echo "пользователь не администратор (нет группы sudo)" >&2; exit 1; }
sid=""
for s in $(loginctl list-sessions --no-legend | awk -v u="$uid" '$2==u {print $1}'); do
  [ "$(loginctl show-session "$s" -p Remote --value)" = no ] || continue
  [ "$(loginctl show-session "$s" -p Active --value)" = yes ] || continue
  sid=$s; break
done
[ -n "$sid" ] || { echo "нет активного локального сеанса пользователя" >&2; exit 1; }
mkdir -p /run/matryoshka-consent
printf '%s\n' "$sid" > "/run/matryoshka-consent/$uid"
chmod 755 /run/matryoshka-consent
chmod 644 "/run/matryoshka-consent/$uid"
exec /usr/lib/matryoshka/root.sh "$@"
