#!/bin/sh
uid=${SUDO_UID:-}
[ "$(id -u)" = 0 ] || exit 1
case "$uid" in ""|*[!0-9]*) exit 1;; esac
ok=0
for s in $(loginctl list-sessions --no-legend | awk -v u="$uid" '$2==u {print $1}'); do
  [ "$(loginctl show-session "$s" -p Remote --value 2>/dev/null)" = no ] || continue
  [ "$(loginctl show-session "$s" -p Active --value 2>/dev/null)" = yes ] || continue
  [ "$(loginctl show-session "$s" -p State --value 2>/dev/null)" = active ] || continue
  /usr/lib/matryoshka/consent-check "$uid" "$s" >/dev/null 2>&1 && { ok=1; break; }
done
[ "$ok" = 1 ] || exit 1
exec /usr/lib/matryoshka/root.sh "$@"
