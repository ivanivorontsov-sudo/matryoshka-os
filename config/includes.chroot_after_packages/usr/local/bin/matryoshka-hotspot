#!/bin/sh
case "$1" in
  off) nmcli connection down Hotspot ;;
  *) P=$(kdialog --title "Точка доступа" --password "Пароль сети (не менее 8 символов):") || exit 0
     [ ${#P} -ge 8 ] || { kdialog --sorry "Пароль короче 8 символов"; exit 1; }
     nmcli device wifi hotspot ssid "Matryoshka-$(hostname)" password "$P" && kdialog --msgbox "Точка доступа Matryoshka-$(hostname) включена. Выключить: matryoshka-hotspot off" || kdialog --sorry "Не удалось: адаптер Wi-Fi может не поддерживать режим точки доступа (проверьте: iw list | grep AP)" ;;
esac
