#!/bin/sh
python3 -c "import sys; sys.path.insert(0, \"/usr/lib/matryoshka\"); import common; common.prep_wine()"
export WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="--no-sandbox --disable-gpu --disable-gpu-compositing --disable-features=RendererCodeIntegrity"
for e in msedgewebview2.exe msedge.exe; do wine reg add "HKCU\\Software\\Wine\\AppDefaults\\$e" /v Version /d win7 /f >/dev/null 2>&1; done
V=109.0.1518.78
FXW="C:\\WebView2Fixed\\Microsoft.WebView2.FixedVersionRuntime.$V.x64"
FX="$HOME/.wine/drive_c/WebView2Fixed/Microsoft.WebView2.FixedVersionRuntime.$V.x64"
URL="https://github.com/westinyang/WebView2RuntimeArchive/releases/download/$V/Microsoft.WebView2.FixedVersionRuntime.$V.x64.cab"
SUM=7622281cf83de1a35e3a471f432f7a897d65f0a7d3975df08512b7b253dd45c7
fixed() {
  [ -f "$FX/msedgewebview2.exe" ] && return 0
  nmcli -t networking | grep -q enabled || { kdialog --title "Конструктор сайтов" --error "Для первого запуска нужен компонент WebView2 $V (около 170 МБ). Включите сеть и запустите конструктор ещё раз."; return 1; }
  kdialog --title "Конструктор сайтов" --passivepopup "Скачиваю WebView2 $V для Wine (около 170 МБ)…" 15 &
  T=$(mktemp -d)
  if curl -fL -o "$T/f.cab" "$URL" && echo "$SUM  $T/f.cab" | sha256sum -c --quiet; then
    mkdir -p "$HOME/.wine/drive_c/WebView2Fixed" && cabextract -q -d "$HOME/.wine/drive_c/WebView2Fixed" "$T/f.cab"
  fi
  rm -rf "$T"
  wine reg add "HKLM\\Software\\Policies\\Microsoft\\EdgeUpdate" /v UpdateDefault /t REG_DWORD /d 0 /f >/dev/null 2>&1
  wine reg add "HKLM\\Software\\Policies\\Microsoft\\EdgeUpdate" /v AutoUpdateCheckPeriodMinutes /t REG_DWORD /d 0 /f >/dev/null 2>&1
  [ -f "$FX/msedgewebview2.exe" ] || { kdialog --title "Конструктор сайтов" --error "Не удалось скачать или проверить WebView2 $V."; return 1; }
}
if [ "${1:-}" = "--fix" ]; then
  shift
  nmcli -t networking | grep -q enabled || { kdialog --title "Конструктор сайтов" --error "Включите сеть."; exit 1; }
  kdialog --title "Конструктор сайтов" --passivepopup "Ставлю DXVK и d3dcompiler_47…" 15 &
  WINEDEBUG=-all winetricks -q dxvk d3dcompiler_47 >/dev/null 2>&1
fi
fixed || exit 1
export WEBVIEW2_BROWSER_EXECUTABLE_FOLDER="$FXW"
exec wine /opt/ivan/sitebuilder/SiteBuilder.exe "$@"
