#!/bin/bash
[ "$(id -u)" = 0 ] || exec pkexec env DISPLAY="$DISPLAY" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" XAUTHORITY="${XAUTHORITY:-}" "$0" "$@"
T="Установка Матрёшки"
CORE=/usr/lib/matryoshka/install-core.sh
items=()
while read -r n s m; do
  [ "$(lsblk -dno RM "$n")" = 1 ] && continue
  items+=("$n" "$n  $s  $m" off)
done < <(lsblk -dnpo NAME,SIZE,MODEL -e 7,11,251 | grep -v zram)
[ ${#items[@]} -gt 0 ] || { kdialog --error "Внутренние диски не найдены."; exit 1; }
items[2]=on
disk=$(kdialog --title "$T" --radiolist "На какой диск установить:" "${items[@]}") || exit 0
mode=$(kdialog --title "$T" --radiolist "Как установить:" free "Только в свободное место (Windows и файлы остаются)" on erase "Весь диск: СТЕРЕТЬ ВСЁ на диске" off) || exit 0
rd=()
if [ -f /run/matryoshka-recover-source ]; then
  s=$(cat /run/matryoshka-recover-source); sd=/dev/$(lsblk -no PKNAME "$s" 2>/dev/null | head -n1)
  if [ "$s" = "$disk" ] || [ "$sd" = "$disk" ]; then
    kdialog --title "$T" --warningyesno "С этого диска спасают файлы ($s).\n\nУстановка ПЕРЕЗАПИШЕТ то, что ещё можно спасти.\n\nВосстановление файлов полностью завершено и всё нужное сохранено на другой диск?" --yes-label "Да, завершено" --no-label "Нет" || exit 0
    a=$(kdialog --title "$T" --inputbox "Напишите слово ЗАВЕРШЕНО, чтобы подтвердить:") || exit 0
    [ "$a" = "ЗАВЕРШЕНО" ] || { kdialog --error "Подтверждение не совпало. Установка отменена."; exit 0; }
    rd=(--recovery-done)
  fi
fi
plan=$("$CORE" --mode "$mode" --disk "$disk" --plan "${rd[@]}" 2>&1) || { kdialog --error "$plan"; exit 1; }
if [ "$mode" = erase ]; then
  kdialog --title "ВНИМАНИЕ" --warningcontinuecancel "$plan\n\nВСЕ ДАННЫЕ В ЭТИХ РАЗДЕЛАХ БУДУТ УНИЧТОЖЕНЫ БЕЗ ВОЗМОЖНОСТИ ВОССТАНОВЛЕНИЯ.\n\nПродолжить?" || exit 0
  a=$(kdialog --title "ВНИМАНИЕ" --inputbox "Напишите слово СТЕРЕТЬ, чтобы подтвердить уничтожение данных:") || exit 0
  [ "$a" = "СТЕРЕТЬ" ] || { kdialog --error "Подтверждение не совпало. Ничего не изменено."; exit 0; }
fi
fullname=$(kdialog --title "$T" --inputbox "Ваше имя:" "Иван") || exit 0
user=$(kdialog --title "$T" --inputbox "Имя для входа (латиница, маленькие буквы):" "ivan") || exit 0
while :; do
  p1=$(kdialog --title "$T" --password "Пароль для входа (не меньше 6 символов):") || exit 0
  p2=$(kdialog --title "$T" --password "Повторите пароль:") || exit 0
  [ "$p1" = "$p2" ] && [ ${#p1} -ge 6 ] && break
  kdialog --sorry "Пароли не совпадают или короче 6 символов."
done
hash=$(printf '%s' "$p1" | openssl passwd -6 -stdin); unset p1 p2
L=/var/log/matryoshka-install.log
konsole --hold -e bash -c "\"$CORE\" --mode \"$mode\" --disk \"$disk\" --user \"$user\" --fullname \"$fullname\" --password-hash '$hash' ${rd[*]} --yes 2>&1 | tee $L; r=\${PIPESTATUS[0]}; [ \$r = 0 ] && echo 'УСТАНОВКА ЗАВЕРШЕНА. Можно перезагрузиться.' || echo 'Установка не удалась. Журнал: $L'"
