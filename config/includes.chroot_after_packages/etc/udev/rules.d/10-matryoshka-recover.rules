IMPORT{cmdline}="matryoshka.recover"
ENV{matryoshka.recover}=="1", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}!="usb", ENV{ID_FS_LABEL}!="MATRYOSHKA", ENV{ID_PART_ENTRY_TYPE}!="de94bba4-06d1-4d40-a16a-bfd50179d6ac", ENV{ID_PART_ENTRY_TYPE}!="c12a7328-f81f-11d2-ba4b-00a0c93ec93b", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0", RUN+="/usr/sbin/blockdev --setro $devnode"
