#!/bin/sh
# Пароль Wi-Fi, который уже работает, сохранить в файл соединения.
# Иначе выключенный бумажник при следующем входе просит пароль сети заново.
IFACE=${DEVICE_IFACE:-$1}
ACTION=${2:-}
[ "$ACTION" = "up" ] || exit 0
[ -d "/sys/class/net/$IFACE/phy80211" ] || exit 0
UUID=${CONNECTION_UUID:-}
[ -n "$UUID" ] || exit 0
exec /usr/bin/python3 /usr/lib/matryoshka/wifi_secret.py "$UUID"
