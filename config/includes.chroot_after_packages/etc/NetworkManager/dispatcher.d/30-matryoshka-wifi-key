#!/bin/sh
# Пароль Wi-Fi, который уже лежит в файле, больше не спрашивать у бумажника.
# Только точка доступа. USB и другие кабели не трогаются.
# Соединение не перечитывается: иначе авторизация начинается заново по кругу.
IFACE=${DEVICE_IFACE:-$1}
ACTION=${2:-}
[ "$ACTION" = "up" ] || exit 0
[ -d "/sys/class/net/$IFACE/phy80211" ] || exit 0
UUID=${CONNECTION_UUID:-}
[ -n "$UUID" ] || exit 0
exec /usr/bin/python3 /usr/lib/matryoshka/wifi_secret.py --pin "$UUID"
