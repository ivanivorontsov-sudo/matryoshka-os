[Unit]
Description=Матрёшка: блок-лист рекламы и трекеров в /etc/hosts
After=live-config.service
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "grep -q StevenBlack /etc/hosts || { echo '# StevenBlack unified hosts'; grep -E '^0\\.0\\.0\\.0 ' /usr/share/matryoshka/hosts/stevenblack | grep -v ' 0\\.0\\.0\\.0$'; } >> /etc/hosts"

[Install]
WantedBy=multi-user.target
