[Unit]
Description=Матрёшка: DNS через systemd-resolved
After=live-config.service
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '[ "$(readlink /etc/resolv.conf)" = ../run/systemd/resolve/stub-resolv.conf ] || ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf'

[Install]
WantedBy=multi-user.target
