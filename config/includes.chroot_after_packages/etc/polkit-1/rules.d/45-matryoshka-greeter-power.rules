polkit.addRule(function(action, subject) {
    if (subject.user != "sddm" || !subject.local) return polkit.Result.NOT_HANDLED;
    var ids = ["org.freedesktop.login1.power-off", "org.freedesktop.login1.power-off-multiple-sessions", "org.freedesktop.login1.reboot", "org.freedesktop.login1.reboot-multiple-sessions"];
    if (ids.indexOf(action.id) >= 0) return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
